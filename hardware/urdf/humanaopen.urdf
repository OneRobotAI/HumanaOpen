<?xml version='1.0' encoding='utf-8'?>
<!--
  HumanaOpen URDF.

  Joint/link names mirror the software (see lerobot_robot_humanaopen/humanaopen.py):
    left_arm_*, right_arm_* (8 joints each: 7-DOF + gripper)
    head_pan, head_tilt
    lift_axis (prismatic)
    base (differential)

  MESHES: STL files copied into meshes/ from hardware/stl/ (HumanaOpen_stl +
  Open-arms-mini-stl). STL is millimetres -> every <mesh> is scale="0.001".
  Arm joint mapping follows open-arms-mini: J1=shoulder_pan, J2=shoulder_lift,
  J3=shoulder_roll, J4=elbow_flex, J5=forearm_rotation, J6=wrist_flex,
  J7=wrist_yaw, J8=gripper (J8 L/R for left/right).

  MESH ORIGIN FIX (2026-09): the HumanaOpen body STLs were CAD-exported with
  geometry centred around (165, 160)mm in each file's own +XY quadrant; visual
  origins carry compensating offsets so meshes sit centred on their link frames.
  Right-arm joint X offsets are mirrored w.r.t. the left arm. Gripper fins mount
  on the inboard side of each J8 jaw.

  ESTIMATES: link origins, collision boxes and inertial values are reasonable
  estimates from the physical design. Measured values from the CAD export
  should eventually replace them; mesh filenames are authoritative.
-->
<robot name="humanaopen">

  <link name="base_link">
    <visual>
      <origin xyz="-0.1650 -0.1600 0.0000" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/6.UpperBase-V10.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.1650 -0.1462 0.0000" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/5.LowerBase-V15.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.1661 -0.1584 0.0000" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/16.ChassisServoHolder-V7.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry><box size="0.20 0.20 0.10" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.01" rpy="0 0 0" />
      <mass value="2.0" />
      <inertia ixx="0.008" iyy="0.008" izz="0.012" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>

  
  <joint name="base_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="base_left_wheel" />
    <origin xyz="0.09 0.0 0.032" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="base_left_wheel">
    <visual>
      <origin xyz="-0.1738 0.0300 -0.1600" rpy="1.5707963 0 0" />
      <geometry>
        <mesh filename="meshes/4.WheelHub.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry><cylinder radius="0.032" length="0.02" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="0.00008" iyy="0.00008" izz="0.00012" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>

  <joint name="base_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="base_right_wheel" />
    <origin xyz="-0.09 0.0 0.032" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="base_right_wheel">
    <visual>
      <origin xyz="-0.1738 0.0300 -0.1600" rpy="1.5707963 0 0" />
